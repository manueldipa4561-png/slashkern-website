---
import type { Copy } from '../i18n/en';
import Rich from './Rich.astro';
import { EMAIL } from '../site';
interface Props { copy: Copy }
const { copy } = Astro.props;
---
<section class="section" aria-labelledby="faq-title">
  <div class="wrap faq-wrap">
    <h2 id="faq-title"><Rich text={copy.faq.title} /></h2>
    <div class="faq">
      {copy.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
    <p class="faq__more">{copy.faq.more} <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
  </div>
</section>
