---
import type { Copy } from '../i18n/en';
interface Props { copy: Copy }
const { copy } = Astro.props;
---
<section class="section" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="section-head section-head--center"><h2 id="faq-title">{copy.faq.title}</h2></div>
    <div class="faq">
      {copy.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
