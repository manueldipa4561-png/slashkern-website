---
import Hero from './Hero.astro';
import ProductCards from './ProductCards.astro';
import Steps from './Steps.astro';
import FindBlock from './FindBlock.astro';
import FinalCta from './FinalCta.astro';
import Profile from './Profile.astro';
import Rich from './Rich.astro';
import type { Copy } from '../i18n/en';
interface Props { copy: Copy }
const { copy } = Astro.props;
const p = copy.companiesPage;
---
<Hero
  chip={copy.nav.companies}
  before={p.before}
  mark={p.mark}
  after={p.after}
  sub={p.sub}
  primary={{ label: p.cta, href: `#${copy.final.id}` }}
  secondary={{ label: p.ctaSecondary, href: `#${copy.how.id}` }}
/>

<section class="section" aria-labelledby="show-title">
  <div class="wrap">
    <div class="section-head"><h2 id="show-title">{p.showTitle}</h2><p class="lead lead--tight">{p.showText}</p></div>
    <ProductCards copy={copy} show={['brief', 'page']} class="cards--plain" />
  </div>
</section>

<section class="section section--soft" aria-labelledby="browse-title">
  <div class="wrap">
    <div class="section-head"><h2 id="browse-title"><Rich text={p.browseTitle} /></h2><p class="lead lead--tight">{p.browseText}</p></div>
    <div class="profiles">
      <Profile copy={copy} who="Sanne" />
      <Profile copy={copy} who="Elin" />
      <Profile copy={copy} who="Mats" />
    </div>
  </div>
</section>

<section class="section" aria-labelledby="features-title">
  <div class="wrap">
    <div class="section-head"><h2 id="features-title">{p.featuresTitle}</h2></div>
    <ul class="features">
      {p.features.map((f) => <li class="feature"><h3>{f.t}</h3><p>{f.d}</p></li>)}
    </ul>
  </div>
</section>

<Steps id={copy.how.id} title={p.howTitle} steps={p.steps} />

<FindBlock copy={copy} />
<FinalCta copy={copy} title={p.ctaTitle} text={p.ctaText} role="company" />
