---
// Sample project artwork, drawn as SVG so it scales to any size. Text comes from the copy (lines) so it can be translated.
// lines: video [caption, length] · poster [word 1, word 2, details] · web [title, button] · listing [title, 3 points]
//        post [handle, 3 caption lines] · music [title, length] · logo [name, tagline] · prompt [3 prompt lines, 3 result lines]
import type { Kind } from '../examples';
interface Props { kind: Kind; lines: string[]; label: string; slice?: boolean; overlay?: boolean }
const { kind, lines, label, slice = false, overlay = false } = Astro.props;
const box: Record<Kind, [number, number]> = { video: [360, 600], poster: [360, 480], web: [400, 300], listing: [360, 440], post: [360, 450], music: [400, 240], logo: [360, 360], prompt: [400, 300] };
const [w, h] = box[kind];
const bars = Array.from({ length: 44 }, (_, i) => 12 + Math.abs(Math.sin(i * 0.62)) * 40 + (i % 5) * 4);
const L = (i: number) => lines[i] ?? '';
---
<svg class="art" viewBox={`0 0 ${w} ${h}`} role="img" aria-label={label} preserveAspectRatio={slice ? 'xMidYMid slice' : 'xMidYMid meet'}>
  {kind === 'video' && (
    <g>
      {!overlay && <image href="/examples/drink-poster.jpg" width="360" height="600" preserveAspectRatio="xMidYMid slice" />}
      <rect y="470" width="360" height="130" fill="#0A0A0A" fill-opacity="0.38" />
      <rect x="22" y="22" width="64" height="28" rx="14" fill="#0A0A0A" fill-opacity="0.78" />
      <text x="54" y="41" text-anchor="middle" fill="#FFFFFF" font-size="14" style="font-family:var(--font-mono);font-weight:500">{L(1)}</text>
      <text x="26" y="540" fill="#FFFFFF" font-size="46" style="font-family:var(--font-ui);font-weight:700;letter-spacing:-1px">{L(0)}</text>
      <rect x="26" y="566" width="308" height="5" rx="2.5" fill="#FFFFFF" fill-opacity="0.35" />
      <rect class="prog" x="26" y="566" width="308" height="5" rx="2.5" fill="#FFFFFF" />
    </g>
  )}
  {kind === 'poster' && (
    <g>
      <rect width="360" height="480" fill="#0A0A0A" />
      <circle cx="180" cy="168" r="108" fill="#FFB547" />
      <text x="26" y="344" fill="#FFFFFF" font-size="92" style="font-family:var(--font-ui);font-weight:700;letter-spacing:-1px">{L(0)}</text>
      <text x="26" y="418" fill="#FFFFFF" font-size="92" font-style="italic" style="font-family:var(--font-ui);font-weight:700;letter-spacing:-1px">{L(1)}</text>
      <rect x="26" y="440" width="308" height="1.5" fill="#FFFFFF" fill-opacity="0.35" />
      <text x="26" y="464" fill="#FFFFFF" fill-opacity="0.85" font-size="13" style="font-family:var(--font-mono);letter-spacing:1.200px">{L(2)}</text>
    </g>
  )}
  {kind === 'web' && (
    <g>
      <rect width="400" height="300" fill="#E4E4DE" />
      <rect x="16" y="16" width="368" height="268" rx="14" fill="#FFFFFF" />
      <circle cx="36" cy="36" r="5" fill="#E4E4DE" /><circle cx="52" cy="36" r="5" fill="#E4E4DE" /><circle cx="68" cy="36" r="5" fill="#E4E4DE" />
      <rect x="96" y="28" width="208" height="16" rx="8" fill="#F4F4F0" />
      <text x="200" y="104" text-anchor="middle" fill="#0A0A0A" font-size="34" style="font-family:var(--font-ui);font-weight:700;letter-spacing:-1px">{L(0)}</text>
      <text x="200" y="182" text-anchor="middle" fill="#0A0A0A" font-size="68" style="font-family:var(--font-mono);font-weight:500;letter-spacing:-2px">25:00</text>
      <rect x="140" y="212" width="120" height="44" rx="22" fill="#FFB547" />
      <text x="200" y="240" text-anchor="middle" fill="#0A0A0A" font-size="16" style="font-family:var(--font-ui);font-weight:600">{L(1)}</text>
    </g>
  )}
  {kind === 'listing' && (
    <g>
      <rect width="360" height="440" fill="#FFFFFF" />
      <image href="/examples/candle.jpg" width="360" height="250" preserveAspectRatio="xMidYMid slice" />
      <text x="26" y="300" fill="#0A0A0A" font-size="34" textLength={L(0).length > 16 ? 308 : undefined} lengthAdjust="spacingAndGlyphs" style="font-family:var(--font-ui);font-weight:700;letter-spacing:-1px">{L(0)}</text>
      {[1, 2, 3].map((n) => (
        <g>
          <path d={`M28 ${324 + (n - 1) * 32}l6 6 12-14`} fill="none" stroke="#0A0A0A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          <text x="60" y={331 + (n - 1) * 32} fill="#5F625A" font-size="16" style="font-family:var(--font-ui)">{L(n)}</text>
        </g>
      ))}
    </g>
  )}
  {kind === 'post' && (
    <g>
      <rect width="360" height="450" fill="#FFFFFF" />
      <circle cx="38" cy="36" r="16" fill="#FFB547" />
      <text x="64" y="42" fill="#0A0A0A" font-size="15" style="font-family:var(--font-ui);font-weight:600">{L(0)}</text>
      <image href="/examples/plant.jpg" y="68" width="360" height="236" preserveAspectRatio="xMidYMid slice" />
      <text x="26" y="338" fill="#0A0A0A" font-size="17" style="font-family:var(--font-ui)">{L(1)}</text>
      <text x="26" y="362" fill="#0A0A0A" font-size="17" style="font-family:var(--font-ui)">{L(2)}</text>
      <text x="26" y="386" fill="#0A0A0A" font-size="17" style="font-family:var(--font-ui)">{L(3)}</text>
      <path d="M32 424c-12-8-16-14-16-21 0-6 4-10 9-10 3 0 5 2 7 4 2-2 4-4 7-4 5 0 9 4 9 10 0 7-4 13-16 21z" fill="none" stroke="#0A0A0A" stroke-width="2" transform="translate(2 8)" />
    </g>
  )}
  {kind === 'music' && (
    <g>
      <rect width="400" height="240" fill="#0A0A0A" />
      <text x="28" y="66" fill="#FFFFFF" font-size="38" style="font-family:var(--font-ui);font-weight:700;letter-spacing:-1px">{L(0)}</text>
      <text x="372" y="66" text-anchor="end" fill="#FFFFFF" fill-opacity="0.7" font-size="14" style="font-family:var(--font-mono)">{L(1)}</text>
      <circle cx="52" cy="158" r="24" fill="#FFFFFF" />
      <path d="M46 146L64 158L46 170Z" fill="#0A0A0A" />
      {bars.map((bh, i) => <rect x={96 + i * 6.6} y={158 - bh / 2} width="3.6" height={bh} rx="1.8" fill={i < 16 ? '#FFB547' : '#FFFFFF'} fill-opacity={i < 16 ? 1 : 0.3} />)}
    </g>
  )}
  {kind === 'logo' && (
    <g>
      <rect width="360" height="360" fill="#F4F4F0" />
      <circle cx="180" cy="150" r="82" fill="#0A0A0A" />
      <g fill="#FFB547">
        <ellipse cx="180" cy="128" rx="9" ry="22" /><ellipse cx="156" cy="146" rx="9" ry="22" transform="rotate(-32 156 146)" /><ellipse cx="204" cy="146" rx="9" ry="22" transform="rotate(32 204 146)" />
        <ellipse cx="156" cy="176" rx="9" ry="22" transform="rotate(-32 156 176)" /><ellipse cx="204" cy="176" rx="9" ry="22" transform="rotate(32 204 176)" />
      </g>
      <rect x="177" y="150" width="6" height="64" rx="3" fill="#FFB547" />
      <text x="180" y="290" text-anchor="middle" fill="#0A0A0A" font-size="70" style="font-family:var(--font-ui);font-weight:700;letter-spacing:-1px">{L(0)}</text>
      <text x="180" y="324" text-anchor="middle" fill="#5F625A" font-size="13" style="font-family:var(--font-mono);letter-spacing:2.400px">{L(1)}</text>
    </g>
  )}
  {kind === 'prompt' && (
    <g>
      <rect width="400" height="300" fill="#F4F4F0" />
      <text x="28" y="44" fill="#5F625A" font-size="12" style="font-family:var(--font-mono);letter-spacing:1.200px">PROMPT</text>
      {[0, 1, 2].map((n) => <text x="28" y={76 + n * 24} fill="#0A0A0A" font-size="16" style="font-family:var(--font-ui);font-weight:500">{L(n)}</text>)}
      <rect x="28" y="150" width="344" height="1.5" fill="#0A0A0A" fill-opacity="0.15" />
      <rect x="28" y="168" width="38" height="20" rx="10" fill="#FFB547" />
      <text x="47" y="182" text-anchor="middle" fill="#0A0A0A" font-size="11" style="font-family:var(--font-mono);font-weight:500">AI</text>
      {[3, 4, 5].map((n) => <text x="28" y={218 + (n - 3) * 24} fill="#3B3B38" font-size="15" style="font-family:var(--font-mono)">{L(n)}</text>)}
    </g>
  )}
</svg>
