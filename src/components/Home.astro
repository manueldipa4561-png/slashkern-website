---
import Hero from './Hero.astro';
import Steps from './Steps.astro';
import FindBlock from './FindBlock.astro';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';
import Rich from './Rich.astro';
import Examples from './Examples.astro';
import Demo from './Demo.astro';
import SpotDemo from './SpotDemo.astro';
import { hrefFor } from '../i18n';
import type { Copy } from '../i18n/en';
interface Props { copy: Copy }
const { copy } = Astro.props;
const lang = copy.lang;
const h = copy.hero;
---
<Hero
  size="xl"
  chip={h.chip}
  before={h.before}
  mark={h.mark}
  after={h.after}
  sub={h.sub}
  primary={{ label: h.ctaPrimary, href: `#${copy.final.id}` }}
  secondary={{ label: h.ctaSecondary, href: `#${copy.how.id}` }}
>
  <Demo copy={copy} />
</Hero>

<SpotDemo copy={copy} />

<section class="section" aria-labelledby="catch-title">
  <div class="wrap catch">
    <h2 id="catch-title"><Rich text={copy.catch.title} /></h2>
    <p class="lead">{copy.catch.text}</p>
  </div>
</section>

<Examples copy={copy} />

<Steps id={copy.how.id} title={copy.how.title} steps={copy.how.steps} />

<section class="section section--tight" aria-labelledby="band-title">
  <div class="wrap">
    <div class="band">
      <h2 id="band-title">{copy.band.title}</h2>
      <div class="band__row"><p>{copy.band.text}</p><a class="btn btn--white btn--go" href={hrefFor(lang, copy.paths.quiz)}>{copy.band.cta}</a></div>
    </div>
  </div>
</section>

<FindBlock copy={copy} />

<section class="section" aria-label={`${copy.nav.creators} / ${copy.nav.companies}`}>
  <div class="wrap split">
    <article class="panel">
      <h2><Rich text={copy.creatorsBlock.title} /></h2>
      <p class="lead">{copy.creatorsBlock.text}</p>
      <ul class="chips" aria-label={copy.creatorsPage.fieldsTitle.replaceAll('*', '')}>
        {copy.fields.map((f) => <li class="chip chip--plain">{f.name}</li>)}
      </ul>
      <a class="arrow-link" href={hrefFor(lang, copy.paths.creators)}>{copy.creatorsBlock.link}</a>
    </article>
    <article class="panel">
      <h2><Rich text={copy.companiesBlock.title} /></h2>
      <p class="lead">{copy.companiesBlock.text}</p>
      <ul class="ticks">
        {copy.companiesBlock.points.map((p) => <li>{p}</li>)}
      </ul>
      <a class="arrow-link" href={hrefFor(lang, copy.paths.companies)}>{copy.companiesBlock.link}</a>
    </article>
  </div>
</section>

<Faq copy={copy} />
<FinalCta copy={copy} title={copy.final.title} text={copy.final.text} />
