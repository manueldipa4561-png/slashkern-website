---
// How companies find creators, said plainly. Shown on home, creators and companies. No amounts anywhere.
import Rich from './Rich.astro';
import type { Copy } from '../i18n/en';
interface Props { copy: Copy }
const { copy } = Astro.props;
const f = copy.find;
---
<section class="section section--soft" id={f.id} aria-labelledby={`${f.id}-title`}>
  <div class="wrap pay">
    <div>
      <h2 id={`${f.id}-title`}><Rich text={f.title} /></h2>
      <p class="lead lead--tight">{f.lead}</p>
      <p class="notice"><strong>{f.notice}</strong></p>
    </div>
    <dl class="pay__rows">
      {f.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </div>
</section>
