---
// A one minute quiz that ends in a share card. Runs in the browser, sends nothing anywhere.
import Rich from './Rich.astro';
import { hrefFor } from '../i18n';
import type { Copy } from '../i18n/en';
import { NAME } from '../site';
import geo from '../slash.json';
interface Props { copy: Copy }
const { copy } = Astro.props;
const q = copy.quiz;
// each result wears the colour of its card in the Examples section: tint = card ground, strong = Slash's eyes and the chips
const HUES = {
  video: { tint: '#d2ebff', strong: '#5bb8ff' },
  poster: { tint: '#fff0c2', strong: '#ffc933' },
  posts: { tint: '#ffd9ec', strong: '#ff8ac4' },
  web: { tint: '#c6f3e4', strong: '#2fd3a3' },
  listing: { tint: '#e4dcff', strong: '#a58bff' },
  music: { tint: '#ffdcd4', strong: '#ff6a55' },
  prompt: { tint: '#dce6ff', strong: '#2d4bff' },
};
const data = {
  quizPath: hrefFor(copy.lang, copy.paths.quiz),
  joinHref: `${hrefFor(copy.lang)}#${copy.final.id}`,
  brand: NAME,
  mark: { viewBox: geo.viewBox, body: geo.body, eyes: geo.eyes.happy },
  hues: HUES,
  t: { progress: q.progress, friend: q.friend, youAre: q.youAre, cardTop: q.cardTop, fun: q.fun, share: q.share, saved: q.saved, copy: q.copy, copied: q.copied, again: q.again, join: q.join, shareText: q.shareText, firstLabel: q.firstLabel, also: q.also },
  questions: q.questions,
  results: q.results,
};
---
<section class="section quiz" aria-labelledby="quiz-title">
  <div class="wrap quiz__wrap">
    <span class="eyebrow">{q.eyebrow}</span>
    <h1 id="quiz-title"><Rich text={q.title} /></h1>
    <div data-intro>
      <p class="lead">{q.lead}</p>
      <p class="quiz__friend" data-friend hidden></p>
      <button class="btn btn--primary quiz__start" type="button" data-start hidden>{q.start}</button>
      <noscript><p class="notice">{q.noscript} <a href={`${hrefFor(copy.lang)}#${copy.final.id}`}>{copy.nav.cta}</a></p></noscript>
    </div>
    <div class="quiz__stage" data-stage></div>
  </div>
</section>
<script type="application/json" id="quiz-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />

<script>
  type Answer = [string, string];
  type Data = {
    quizPath: string; joinHref: string; brand: string;
    t: Record<string, string>;
    questions: Array<{ q: string; a: Answer[] }>;
    results: Record<string, { name: string; line: string; first: string }>;
    mark: { viewBox: string; body: string; eyes: string };
    hues: Record<string, { tint: string; strong: string }>;
  };
  const raw = document.getElementById('quiz-data');
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const startBtn = document.querySelector<HTMLButtonElement>('[data-start]');
  const friend = document.querySelector<HTMLElement>('[data-friend]');
  if (raw && stage && intro && startBtn && friend) {
    const d: Data = JSON.parse(raw.textContent ?? '{}');
    const keys = Object.keys(d.results);
    const fmt = (s: string, vars: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text = '') => {
      const node = document.createElement(tag);
      node.className = cls;
      if (text) node.textContent = text;
      return node;
    };

    startBtn.hidden = false;
    const fromFriend = new URLSearchParams(location.search).get('r');
    if (fromFriend && Object.prototype.hasOwnProperty.call(d.results, fromFriend)) {
      friend.textContent = fmt(d.t.friend, { name: d.results[fromFriend].name });
      friend.hidden = false;
    }

    const scores: Record<string, number> = {};
    const lastSeen: Record<string, number> = {};
    let step = 0;

    const start = () => {
      step = 0;
      for (const k of keys) { scores[k] = 0; delete lastSeen[k]; }
      intro.hidden = true;
      renderQuestion();
    };
    startBtn.addEventListener('click', start);

    function renderQuestion() {
      const item = d.questions[step];
      stage!.replaceChildren();
      const box = el('div', 'quiz__step');
      const heading = el('h2', 'quiz__q', item.q);
      heading.tabIndex = -1;
      const list = el('div', 'quiz__answers');
      item.a.forEach(([text, key]) => {
        const b = el('button', 'ans', text);
        b.type = 'button';
        b.addEventListener('click', () => {
          scores[key] = (scores[key] ?? 0) + 1;
          lastSeen[key] = step;
          step += 1;
          if (step < d.questions.length) renderQuestion();
          else renderResult();
        });
        list.append(b);
      });
      const dots = el('div', 'quiz__dots');
      d.questions.forEach((_, i) => dots.append(el('i', i <= step ? 'on' : '')));
      box.append(el('p', 'quiz__prog', fmt(d.t.progress, { n: step + 1, total: d.questions.length })), dots, heading, list);
      stage!.append(box);
      heading.focus({ preventScroll: true });
      box.scrollIntoView({ block: 'nearest' });
    }

    // most picks wins; a tie goes to the latest pick (the last question asks what you would make this weekend)
    const ranked = () => [...keys].sort((a, b) => (scores[b] - scores[a]) || ((lastSeen[b] ?? -1) - (lastSeen[a] ?? -1)));

    const SVG = 'http://www.w3.org/2000/svg';
    function slashSvg(cls: string) {
      const svg = document.createElementNS(SVG, 'svg');
      svg.setAttribute('viewBox', d.mark.viewBox);
      svg.setAttribute('class', cls);
      svg.setAttribute('aria-hidden', 'true');
      for (const [dd, c] of [[d.mark.body, 'rcard__body'], [d.mark.eyes, 'rcard__eyes']]) {
        const path = document.createElementNS(SVG, 'path');
        path.setAttribute('d', dd); path.setAttribute('class', c); svg.append(path);
      }
      return svg;
    }

    function renderResult() {
      const order = ranked();
      const key = order[0];
      const r = d.results[key];
      const hue = d.hues[key];
      const mix = order.slice(1).filter((k) => scores[k] > 0).map((k) => d.results[k].name);
      const link = `${location.origin}${d.quizPath}?r=${key}`;
      const text = fmt(d.t.shareText, { name: r.name });
      const png = makeBlob(r, hue, mix); // render now so the share click can answer at once (iOS needs it)
      stage!.replaceChildren();
      const card = el('div', 'rcard');
      card.style.setProperty('--tint', hue.tint);
      card.style.setProperty('--strong', hue.strong);
      const first = el('div', 'rcard__first');
      first.append(el('p', 'rcard__label', d.t.firstLabel), el('p', 'rcard__project', r.first));
      card.append(slashSvg('rcard__slash'), el('p', 'rcard__top', d.t.cardTop), el('p', 'rcard__you', d.t.youAre), el('h2', 'rcard__name', r.name), el('p', 'rcard__line', r.line), first);
      if (mix.length) {
        const also = el('div', 'rcard__mix');
        const chips = el('ul', 'rcard__chips');
        mix.forEach((n) => chips.append(el('li', '', n)));
        also.append(el('p', 'rcard__label', d.t.also), chips);
        card.append(also);
      }
      const actions = el('div', 'quiz__actions');
      const shareBtn = el('button', 'btn btn--primary', d.t.share);
      shareBtn.type = 'button';
      const copyBtn = el('button', 'btn btn--ghost', d.t.copy);
      copyBtn.type = 'button';
      const again = el('button', 'btn btn--ghost', d.t.again);
      again.type = 'button';
      const join = el('a', 'btn btn--accent', d.t.join);
      join.href = d.joinHref;
      actions.append(shareBtn, copyBtn, join, again);
      const live = el('p', 'form__small quiz__live', d.t.fun);
      live.setAttribute('role', 'status');
      stage!.append(card, actions, live);
      card.tabIndex = -1;
      card.focus({ preventScroll: true });
      card.scrollIntoView({ block: 'start' });

      const say = (msg: string) => { live.textContent = msg; setTimeout(() => { live.textContent = d.t.fun; }, 2400); };
      const copyLink = async () => { try { await navigator.clipboard.writeText(link); say(d.t.copied); } catch { live.textContent = link; } }; // no clipboard: show the link to copy by hand
      copyBtn.addEventListener('click', copyLink);
      again.addEventListener('click', () => { history.replaceState(null, '', d.quizPath); start(); });
      shareBtn.addEventListener('click', async () => {
        const blob = await png;
        const file = blob ? new File([blob], 'slashkern.png', { type: 'image/png' }) : null;
        try {
          if (file && navigator.canShare?.({ files: [file] })) return void (await navigator.share({ files: [file], text: `${text} ${link}` }));
          if (navigator.share) return void (await navigator.share({ text, url: link }));
        } catch (err) {
          if ((err as Error).name === 'AbortError') return;
        }
        if (blob) { // no share sheet (desktop): save the image and copy the link
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = 'slashkern.png';
          a.click();
          setTimeout(() => URL.revokeObjectURL(a.href), 4000);
        }
        await copyLink();
      });
    }

    // The share image: 1080 x 1350, the same card as on the page, drawn with the site's own fonts.
    async function makeBlob(r: { name: string; line: string; first: string }, hue: { tint: string; strong: string }, mix: string[]): Promise<Blob | null> {
      try {
        await Promise.all([
          document.fonts.load('650 120px "Geist Variable"'),
          document.fonts.load('500 40px "Geist Variable"'),
          document.fonts.load('500 28px "Geist Mono Variable"'),
        ]);
        const W = 1080, H = 1350, M = 84, INK = '#0E1B3D';
        const c = document.createElement('canvas');
        c.width = W; c.height = H;
        const g = c.getContext('2d')!;
        g.fillStyle = hue.tint; g.fillRect(0, 0, W, H);
        // Slash, large, top right: navy pointer with the result's colour in its eyes
        const [vx, vy, , vh] = d.mark.viewBox.split(' ').map(Number), ms = 330 / vh;
        g.save(); g.translate(W - 330, 60); g.rotate(-0.12); g.scale(ms, ms); g.translate(-vx, -vy);
        g.fillStyle = INK; g.fill(new Path2D(d.mark.body)); g.fillStyle = hue.strong; g.fill(new Path2D(d.mark.eyes)); g.restore();

        const wrap = (text: string, font: string, maxW: number) => {
          g.font = font;
          const lines: string[] = []; let cur = '';
          for (const w of text.split(' ')) { const t = cur ? `${cur} ${w}` : w; if (g.measureText(t).width > maxW && cur) { lines.push(cur); cur = w; } else cur = t; }
          if (cur) lines.push(cur);
          return lines;
        };
        g.fillStyle = INK;
        g.globalAlpha = 0.72; g.font = '500 28px "Geist Mono Variable", monospace';
        for (const [i, ln] of wrap(d.t.cardTop.toUpperCase(), g.font, 560).entries()) g.fillText(ln, M, 130 + i * 40);
        g.globalAlpha = 1; g.font = '600 64px "Geist Variable", sans-serif';
        g.fillText(d.t.youAre, M, 440);

        let fs = 168; let lines = wrap(r.name, `650 ${fs}px "Geist Variable", sans-serif`, W - 2 * M);
        while (lines.length > 2 && fs > 104) { fs -= 16; lines = wrap(r.name, `650 ${fs}px "Geist Variable", sans-serif`, W - 2 * M); }
        let y = 440 + fs * 1.0;
        g.font = `650 ${fs}px "Geist Variable", sans-serif`;
        for (const [i, ln] of lines.entries()) { if (i) y += fs * 0.98; g.fillText(ln, M - 6, y); }
        const lineFont = '500 46px "Geist Variable", sans-serif';
        y += 96;
        for (const ln of wrap(r.line, lineFont, W - 2 * M)) { g.font = lineFont; g.fillText(ln, M, y); y += 58; }

        // the first project, on a white panel like a project card in the app
        const projFont = '650 48px "Geist Variable", sans-serif';
        const proj = wrap(r.first, projFont, W - 2 * M - 96);
        // bottom up: footer, then the mix chips, then the panel; the panel never rises into the line above it
        const chipsY = H - 230, ph = 120 + proj.length * 58, py = Math.max(y, (mix.length ? chipsY - 28 : H - 170) - ph);
        g.fillStyle = '#FFFFFF'; g.beginPath(); g.roundRect(M, py, W - 2 * M, ph, 36); g.fill();
        g.fillStyle = INK; g.globalAlpha = 0.7; g.font = '500 26px "Geist Mono Variable", monospace';
        g.fillText(d.t.firstLabel.toUpperCase(), M + 48, py + 64);
        g.globalAlpha = 1;
        proj.forEach((ln, i) => { g.font = projFont; g.fillText(ln, M + 48, py + 122 + i * 58); });

        if (mix.length) {
          g.font = '600 30px "Geist Variable", sans-serif';
          let x = M; const cy = chipsY;
          for (const n of mix.slice(0, 3)) {
            const w = g.measureText(n).width + 44;
            if (x + w > W - M) break;
            g.fillStyle = 'rgba(14,27,61,0.08)'; g.beginPath(); g.roundRect(x, cy, w, 56, 28); g.fill();
            g.fillStyle = INK; g.fillText(n, x + 22, cy + 38); x += w + 12;
          }
        }
        g.fillStyle = INK; g.font = '800 54px "Geist Variable", sans-serif';
        g.fillText(d.brand, M, H - 74);
        g.globalAlpha = 0.7; g.font = '500 28px "Geist Mono Variable", monospace'; g.textAlign = 'right';
        g.fillText(location.host, W - M, H - 82);
        g.globalAlpha = 1;
        return await new Promise<Blob | null>((res) => c.toBlob(res, 'image/png'));
      } catch { return null; }
    }
  }
</script>
