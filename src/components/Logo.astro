---
// The mark: one solid disc with one diagonal slit (design/logo/out-slit), plus the lowercase wordmark.
// tone="white" is the version for the dark hero.
import { WORDMARK } from '../site';
interface Props { size?: number; markOnly?: boolean; tone?: 'ink' | 'white' }
const { size = 32, markOnly = false, tone = 'ink' } = Astro.props;
const fill = tone === 'white' ? '#FFFFFF' : '#0A0A0A';
---
<span class:list={['logo', `logo--${tone}`]}>
  <svg width={size} height={size} viewBox="6 6 52 52" aria-hidden="true" focusable="false">
    <g transform="rotate(-45 32 32)" fill={fill}>
      <path d="M7 29A25 25 0 0 1 57 29Z" />
      <path d="M7 35A25 25 0 0 0 57 35Z" />
    </g>
  </svg>
  {!markOnly && <span class="logo__word" aria-hidden="true">{WORDMARK}</span>}
</span>
