---
// The logo is the mark alone: the eyes pointer (navy body, ice eyes), no text in it. The header sets the name beside it.
// tone="white" is the reversed version for dark grounds. Geometry: src/slash.json (same drawing as Slash, the assistant).
import { WORDMARK } from '../site';
import geo from '../slash.json';
interface Props { size?: number; markOnly?: boolean; tone?: 'ink' | 'white' }
const { size = 32, markOnly = false, tone = 'ink' } = Astro.props;
const [body, eyes] = tone === 'white' ? ['#F5F2EA', '#0E1B3D'] : ['#0E1B3D', '#DCE6FF'];
---
<span class:list={['logo', `logo--${tone}`]}>
  <svg width={size} height={size} viewBox={geo.viewBox} aria-hidden="true" focusable="false">
    <path d={geo.body} fill={body} />
    <path d={geo.eyes.neutral} fill={eyes} />
  </svg>
  {!markOnly && <span class="logo__word" aria-hidden="true">{WORDMARK.slice(0, -2)}<span class="logo__rn">r</span>n</span>}
</span>
