---
// HTML/CSS mock screens. Everything here is labelled Example; no real brands, people or numbers.
import Logo from './Logo.astro';
import type { Copy } from '../i18n/en';
type CardName = 'brief' | 'coach' | 'page';
interface Props { copy: Copy; show?: CardName[]; class?: string }
const { copy, show = ['brief', 'coach', 'page'], class: extra = '' } = Astro.props;
const c = copy.cards;
const art = ['a', 'b', 'c'];
---
<section class:list={['cards', extra]} data-count={show.length} aria-label={c.aria}>
  {show.includes('brief') && (
    <article class="card">
      <div class="card__head">
        <span class="card__label">{c.brief.label} · {c.brief.from}</span>
        <span class="chip chip--example">{copy.example}</span>
      </div>
      <h3>{c.brief.title}</h3>
      <dl class="card__rows">
        {c.brief.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p>{c.brief.body}</p>
      <div class="card__foot">
        <span class="chip chip--price">{c.brief.price}</span>
        <span>{c.brief.priceNote}</span>
      </div>
    </article>
  )}
  {show.includes('coach') && (
    <article class="card">
      <div class="card__head">
        <span class="coach-who"><Logo size={26} markOnly /><span class="card__label">{c.coach.label}</span></span>
        <span class="chip chip--example">{copy.example}</span>
      </div>
      <div class="chat">
        <p class="bubble bubble--you">{c.coach.you}</p>
        <p class="bubble bubble--coach">{c.coach.question}</p>
        <p class="bubble bubble--you">{c.coach.reply}</p>
      </div>
      <p class="card__foot">{c.coach.hint}</p>
    </article>
  )}
  {show.includes('page') && (
    <article class="card">
      <div class="card__head">
        <span class="who"><span class="avatar" aria-hidden="true"></span><span><strong>{c.page.name}</strong><br /><span class="card__label">{c.page.fields}</span></span></span>
        <span class="chip chip--example">{copy.example}</span>
      </div>
      <h3 class="card__sub">{c.page.label}</h3>
      <ul class="tiles">
        {c.page.items.map((item, i) => (
          <li class="tile">
            <span class:list={['tile__art', `tile__art--${art[i % art.length]}`]} aria-hidden="true"></span>
            <span class="tile__t">{item.t}</span>
            <span class="tile__f">{item.f}</span>
          </li>
        ))}
      </ul>
      <p class="card__foot">{c.page.foot}</p>
    </article>
  )}
</section>
