---
// HTML/CSS mock screens. Everything here is labelled Example; no real brands, people, prices or numbers.
import Slash from './Slash.astro';
import type { Copy } from '../i18n/en';
type CardName = 'practice' | 'brief' | 'coach' | 'page';
interface Props { copy: Copy; show?: CardName[]; class?: string }
const { copy, show = ['practice', 'coach', 'page'], class: extra = '' } = Astro.props;
const c = copy.cards;
const art = ['a', 'b', 'c'];
---
<section class:list={['cards', extra]} data-count={show.length} aria-label={c.aria}>
  {show.includes('practice') && (
    <article class="card">
      <div class="card__head">
        <span class="card__label">{c.practice.label}</span>
        <span class="chip chip--example">{copy.example}</span>
      </div>
      <h3>{c.practice.title}</h3>
      <dl class="card__rows">
        {c.practice.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p>{c.practice.body}</p>
      <p class="card__foot">{c.practice.foot}</p>
    </article>
  )}
  {show.includes('brief') && (
    <article class="card">
      <div class="card__head">
        <span class="card__label">{c.brief.label} · {c.brief.from}</span>
        <span class="chip chip--example">{copy.example}</span>
      </div>
      <h3>{c.brief.title}</h3>
      <dl class="card__rows">
        {c.brief.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p>{c.brief.body}</p>
      <p class="card__foot">{c.brief.foot}</p>
    </article>
  )}
  {show.includes('coach') && (
    <article class="card">
      <div class="card__head">
        <span class="coach-who"><Slash mood="asking" size="1.75rem" /><span class="card__label">{c.coach.label}</span></span>
        <span class="chip chip--example">{copy.example}</span>
      </div>
      <div class="chat">
        <p class="bubble bubble--you">{c.coach.you}</p>
        <p class="bubble bubble--coach">{c.coach.question}</p>
        <p class="bubble bubble--you">{c.coach.reply}</p>
      </div>
      <div class="card__actions">
        <span class="fake-btn">{c.coach.action}</span>
        <span class="mic" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" focusable="false"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>
        </span>
      </div>
      <div class="draft">
        <div class="draft__head">
          <span class="card__label">{c.coach.draftLabel}</span>
          <span class="chip chip--ink">{c.coach.draftChip}</span>
        </div>
        <p>{c.coach.draft}</p>
        <p class="draft__note">{c.coach.draftNote}</p>
      </div>
      <p class="card__foot">{c.coach.mic}</p>
    </article>
  )}
  {show.includes('page') && (
    <article class="card">
      <div class="card__head">
        <span class="who"><span class="avatar" aria-hidden="true"></span><span><strong>{c.page.name}</strong><br /><span class="card__label">{c.page.fields}</span></span></span>
        <span class="chip chip--example">{copy.example}</span>
      </div>
      <h3 class="card__sub">{c.page.label}</h3>
      <ul class="tiles">
        {c.page.items.map((item, i) => (
          <li class="tile">
            <span class:list={['tile__art', `tile__art--${art[i % art.length]}`]} aria-hidden="true"></span>
            <span class="tile__t">{item.t}</span>
            <span class="tile__f">{item.f}</span>
          </li>
        ))}
      </ul>
      <p class="card__foot">{c.page.foot}</p>
    </article>
  )}
</section>
