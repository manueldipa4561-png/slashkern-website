---
// Home gallery: eight finished things, each one real: a clip that plays, a poster, a timer that runs, a listing, a post, a jingle that plays, a logo, a prompt and its answer.
// The clients are made up and every AI-made part says so (copy.examples.tags). Reading order = column order on a wide screen, and the columns balance themselves.
import Rich from './Rich.astro';
import ExTimer from './ExTimer.astro';
import ExJingle from './ExJingle.astro';
import '../styles/examples.css';
import type { Copy } from '../i18n/en';
interface Props { copy: Copy }
const { copy } = Astro.props;
const e = copy.examples, g = e.gallery;
const poster = copy.lang === 'it' ? '/examples/poster-serata-cinema.jpg' : '/examples/poster-film-night.jpg';
const TILES = [
  { kind: 'video', hue: 'sky', tag: 'ai' },
  { kind: 'post', hue: 'pink', tag: 'ai' },
  { kind: 'timer', hue: 'mint', tag: 'code' },
  { kind: 'logo', hue: 'blue', tag: 'ai' },
  { kind: 'listing', hue: 'lilac', tag: 'ai' },
  { kind: 'poster', hue: 'sun', tag: 'ai' },
  { kind: 'jingle', hue: 'coral', tag: 'ai' },
  { kind: 'prompt', hue: 'navy', tag: 'answer' },
] as const;
const PROMPT_KINDS = ['task', 'context', 'limit', 'format'] as const; // the four parts of the prompt, in the order of g.prompt.parts and g.prompt.kinds (each has its own colour)
---
<section class="section section--soft examples" aria-labelledby="examples-title">
  <div class="wrap">
    <div class="examples__head">
      <h2 id="examples-title"><Rich text={e.title} /></h2>
      <p class="lead">{e.lead}</p>
    </div>
    <ul class="gallery" role="list">
      {TILES.map(({ kind, hue, tag }) => (
        <li class={`ex ex--${hue}`}>
          {kind === 'video' && (
            <div class="ex__media vid">
              <video src="/examples/saltz8salt.mp4" poster="/examples/saltz8salt-poster.jpg" muted loop playsinline preload="none" data-autoplay aria-label={g.video.alt}></video>
              <span class="vid__len" aria-hidden="true">{g.video.len}</span>
              <button type="button" class="vbtn" data-toggle-video aria-label={copy.demo.pause} data-play={copy.demo.play} data-pause={copy.demo.pause}>
                <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
                <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg>
              </button>
            </div>
          )}
          {kind === 'timer' && <ExTimer t={g.timer} nojs={e.nojs} />}
          {kind === 'poster' && <div class="ex__media"><img src={poster} width="880" height="1168" loading="lazy" decoding="async" alt={g.poster.alt} /></div>}
          {kind === 'jingle' && <ExJingle t={g.jingle} nojs={e.nojs} />}
          {kind === 'post' && (
            <div class="ex__media post">
              <p class="post__head"><span class="post__av" aria-hidden="true">sp</span>{g.post.handle}</p>
              <img src="/examples/plant-repot.jpg" width="720" height="900" loading="lazy" decoding="async" alt={g.post.alt} />
              <svg class="post__heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></svg>
              <p class="post__cap">{g.post.caption}</p>
            </div>
          )}
          {kind === 'logo' && <div class="ex__media"><img src="/examples/logo-forno-gufo.jpg" width="760" height="760" loading="lazy" decoding="async" alt={g.logo.alt} /></div>}
          {kind === 'listing' && (
            <div class="ex__media listing">
              <img src="/examples/candle-cera.jpg" width="800" height="1000" loading="lazy" decoding="async" alt={g.listing.alt} />
              <div class="listing__body">
                <p class="listing__t">{g.listing.title}</p>
                <ul role="list">{g.listing.points.map((point) => <li>{point}</li>)}</ul>
              </div>
            </div>
          )}
          {kind === 'prompt' && (
            <div class="ex__media pr" data-prompt data-mode="strong" data-strong={g.prompt.parts.join(' ')} data-weak={g.prompt.weak} data-copy-label={g.prompt.copy} data-copied={g.prompt.copied}>
              <div class="pr__top">
                <p class="pr__l">{g.prompt.promptLabel}</p>
                <div class="pr__switch" role="group" aria-label={g.prompt.switchLabel}>
                  <button type="button" aria-pressed="false" data-mode-btn="weak">{g.prompt.weakLabel}</button>
                  <button type="button" aria-pressed="true" data-mode-btn="strong">{g.prompt.strongLabel}</button>
                </div>
              </div>
              <p class="pr__text" data-when="strong">{g.prompt.parts.map((text, i) => <><span class={`pr__p pr__p--${PROMPT_KINDS[i]}`}>{text}</span>{' '}</>)}</p>
              <p class="pr__text" data-when="weak" hidden>{g.prompt.weak}</p>
              <ul class="pr__legend" role="list">{g.prompt.kinds.map((k, i) => <li class={`pr__k pr__k--${PROMPT_KINDS[i]}`}>{k}</li>)}</ul>
              <p class="pr__same">{g.prompt.same}</p>
              <div class="pr__ans">
                <span class="chip chip--tag">{g.prompt.answerLabel}</span>
                <ol data-when="strong">{g.prompt.answer.map((line) => <li>{line}</li>)}</ol>
                <p class="pr__weak" data-when="weak" hidden>{g.prompt.weakAnswer}</p>
              </div>
              <button type="button" class="pr__copy" data-copy aria-live="polite">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5" /><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15" /></svg>
                <span data-copy-text>{g.prompt.copy}</span>
              </button>
            </div>
          )}
          <div class="ex__body">
            <p class="ex__field">{g[kind].field}</p>
            <h3>{g[kind].t}</h3>
            <p class="ex__for">{g[kind].for}</p>
            <p class="ex__tags"><span class="chip chip--example">{copy.example}</span><span class="chip chip--tag">{e.tags[tag]}</span></p>
          </div>
        </li>
      ))}
    </ul>
    <p class="gallery__cta"><a class="btn btn--accent" href={`#${copy.final.id}`}>{e.mine}</a></p>
  </div>
</section>

<script>
  // The prompt card: Vague / Clear switches the prompt and the AI's answer; the copy button copies the prompt on show.
  document.querySelectorAll<HTMLElement>('[data-prompt]').forEach((root) => {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]')];
    const parts = [...root.querySelectorAll<HTMLElement>('[data-when]')];
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]')!;
    const label = root.querySelector<HTMLElement>('[data-copy-text]')!;
    const text: Record<string, string> = { strong: root.dataset.strong!, weak: root.dataset.weak! };
    let mode = 'strong', timer = 0;
    const show = (m: string) => {
      root.style.minHeight = m === 'weak' ? `${root.offsetHeight}px` : ''; // the card keeps its height, so the other cards do not move
      mode = m; root.dataset.mode = m;
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBtn === m)));
      parts.forEach((p) => { p.hidden = p.dataset.when !== m; });
    };
    btns.forEach((b) => b.addEventListener('click', () => show(b.dataset.modeBtn!)));
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(text[mode]); } catch { return; } // no clipboard (an old browser, or blocked): nothing is claimed
      label.textContent = root.dataset.copied!; copy.classList.add('is-ok');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { label.textContent = root.dataset.copyLabel!; copy.classList.remove('is-ok'); }, 1600);
    });
  });
</script>
