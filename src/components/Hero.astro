---
// Light hero: copy on the left, a visual on the right (the page passes the real product video, sub pages get Slash).
// Four text elements at most: one chip, the headline, one sub line, the buttons. The key words take the accent colour.
import Slash from './Slash.astro';
interface Link { label: string; href: string }
interface Props {
  chip: string;
  before: string;
  mark: string;
  after?: string;
  sub: string;
  primary: Link;
  secondary?: Link;
  size?: 'xl' | 'lg';
}
const { chip, before, mark, after = '', sub, primary, secondary, size = 'lg' } = Astro.props;
const hasVisual = Astro.slots.has('default');
---
<section class:list={['hero', `hero--${size}`]}>
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <span class="chip">{chip}</span>
      <h1>{before}{mark.split(' ').map((word, i) => <>{i > 0 && ' '}<span class="hl">{word}</span></>)}{after.split('\n').flatMap((line, i) => (i ? [<br />, line] : [line]))}</h1>
      <p class="hero__sub">{sub}</p>
      <div class="cta-row">
        <a class="btn btn--primary" href={primary.href}>{primary.label}</a>
        {secondary && <a class="arrow-link" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
    <div class="hero__visual">
      {!hasVisual && <Slash class="hero__slash" size="clamp(11rem, 24vw, 18rem)" float look grounded />}
      {hasVisual && <slot />}
    </div>
  </div>
</section>
