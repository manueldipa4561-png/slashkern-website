---
// Near-black hero block: huge serif headline, one lime button, ghost mark in the corner.
interface Link { label: string; href: string }
interface Props {
  chip: string;
  before: string;
  mark: string;
  after?: string;
  sub: string;
  primary: Link;
  secondary?: Link;
  note?: string;
  overlap?: boolean; // leave room for the card strip that overlaps the hero's lower edge
  size?: 'xl' | 'lg';
}
const { chip, before, mark, after = '', sub, primary, secondary, note, overlap = false, size = 'lg' } = Astro.props;
---
<section class:list={['hero', `hero--${size}`, overlap && 'hero--overlap']}>
  <svg class="hero__ghost" viewBox="6 6 52 52" aria-hidden="true" focusable="false">
    <g transform="rotate(-45 32 32)">
      <path d="M7 29A25 25 0 0 1 57 29Z" />
      <path d="M7 35A25 25 0 0 0 57 35Z" />
    </g>
  </svg>
  <div class="wrap hero__inner">
    <span class="chip chip--dark">{chip}</span>
    <h1>{before}<span class="hl">{mark}</span>{after.split('\n').flatMap((line, i) => (i ? [<br />, line] : [line]))}</h1>
    <p class="hero__sub">{sub}</p>
    <div class="cta-row">
      <a class="btn btn--lime" href={primary.href}>{primary.label}</a>
      {secondary && <a class="btn btn--ghost-dark" href={secondary.href}>{secondary.label}</a>}
    </div>
    {note && <p class="hero__note">{note}</p>}
  </div>
</section>
