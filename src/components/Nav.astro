---
import Logo from './Logo.astro';
import type { Copy } from '../i18n/en';
import { hrefFor, copyFor } from '../i18n';
interface Props { copy: Copy; page: string; other: string; dark: boolean }
const { copy, page, other, dark } = Astro.props;
const lang = copy.lang;
const cur = (p: string) => (page === p ? 'page' : undefined);
const otherSlug = page === 'home' ? undefined : copyFor(other).paths[page as keyof Copy['paths']];
const ctaHref = dark ? `#${copy.final.id}` : `${hrefFor(lang)}#${copy.final.id}`;
---
<header class:list={['nav', dark && 'nav--dark']}>
  <div class="wrap nav__row">
    <a class="logo-link" href={hrefFor(lang)} aria-label={copy.nav.home}><Logo tone={dark ? 'white' : 'ink'} /></a>
    <nav class="nav__links" aria-label={copy.nav.aria}>
      <a href={hrefFor(lang, copy.paths.creators)} aria-current={cur('creators')}>{copy.nav.creators}</a>
      <a href={hrefFor(lang, copy.paths.companies)} aria-current={cur('companies')}>{copy.nav.companies}</a>
      <a class="nav__lang" href={hrefFor(other, otherSlug)} hreflang={other} lang={other} aria-label={copy.switchTo.aria}>
        <span class="short" aria-hidden="true">{copy.switchTo.short}</span><span class="long">{copy.switchTo.label}</span>
      </a>
    </nav>
    <a class="btn btn--primary btn--sm btn--go nav__cta" href={ctaHref}>{copy.nav.cta}</a>
  </div>
</header>
