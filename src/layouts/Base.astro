---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, NAME, INSTAGRAM_URL } from '../site';
import type { Copy } from '../i18n/en';
import { hrefFor } from '../i18n';

interface Props {
  copy: Copy;
  page: 'home' | 'creators' | 'companies' | 'quiz' | 'privacy' | 'terms';
  noindex?: boolean; // the 404 page only: robots noindex, no canonical, no hreflang, no JSON-LD
  title?: string; // the 404 page only: replaces the title of the page
}
const { copy, page, noindex = false, title } = Astro.props;
const lang = copy.lang;
const other = lang === 'it' ? 'en' : 'it';
const meta = { ...copy.meta[page], ...(title ? { title } : {}) };
const slug = page === 'home' ? undefined : copy.paths[page];
const abs = (l: string) => SITE_URL + hrefFor(l, slug);
const ogImage = `${SITE_URL}/${lang === 'it' ? 'og-it' : 'og'}.png`; // each language has its own share image
const ogAlt = `${NAME}: ${copy.slogan}`;
const dark = false; // one light theme for the whole site

// Organization + WebSite on the two home pages only: that is where search engines read the site name and logo.
const homeUrl = SITE_URL + hrefFor(lang);
const orgId = `${SITE_URL}/#organization`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': orgId, name: NAME, url: `${SITE_URL}/`, logo: { '@type': 'ImageObject', url: `${SITE_URL}/icon-512.png`, width: 512, height: 512 }, sameAs: [INSTAGRAM_URL] },
    { '@type': 'WebSite', '@id': `${homeUrl}#website`, name: NAME, url: homeUrl, inLanguage: lang, publisher: { '@id': orgId } },
  ],
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={abs(lang)} />
        <link rel="alternate" hreflang="en" href={abs('en')} />
        <link rel="alternate" hreflang="it" href={abs('it')} />
        <link rel="alternate" hreflang="x-default" href={abs('en')} />
      </>
    )}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={NAME} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={dark ? '#0e1b3d' : '#ffffff'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:locale" content={copy.ogLocale} />
    <meta property="og:locale:alternate" content={other === 'it' ? 'it_IT' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="generator" content={Astro.generator} />
    {page === 'home' && !noindex && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip" href="#main">{copy.skip}</a>
    <Nav copy={copy} page={page} other={other} dark={dark} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer copy={copy} />
    <script>
      // Slash looks toward the pointer (eyes only, a few pixels). Pointer devices only, never with reduced motion.
      (function () {
        if (!window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) return;
        var kerns = document.querySelectorAll('[data-slash-look]');
        if (!kerns.length) return;
        var raf = 0, px = 0, py = 0;
        document.addEventListener('pointermove', function (e) {
          px = e.clientX; py = e.clientY;
          if (raf) return;
          raf = requestAnimationFrame(function () {
            raf = 0;
            kerns.forEach(function (k) {
              var r = k.getBoundingClientRect();
              var dx = (px - (r.left + r.width / 2)) / Math.max(r.width * 4, 240), dy = (py - (r.top + r.height / 2)) / Math.max(r.height * 4, 240);
              k.style.setProperty('--lx', Math.max(-1, Math.min(1, dx)).toFixed(2));
              k.style.setProperty('--ly', Math.max(-1, Math.min(1, dy)).toFixed(2));
            });
          });
        }, { passive: true });
      })();
    </script>
    <script>
      // The main buttons: a soft light follows the pointer across them. Mouse and trackpad only, never with reduced motion.
      if (window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
        document.addEventListener('pointermove', function (e) {
          var b = e.target.closest && e.target.closest('.btn--go');
          if (!b) return;
          var r = b.getBoundingClientRect();
          b.style.setProperty('--x', (e.clientX - r.left).toFixed(0) + 'px');
          b.style.setProperty('--y', (e.clientY - r.top).toFixed(0) + 'px');
        }, { passive: true });
      }
    </script>
    <script>
      // Share buttons: the phone's share sheet where there is one, otherwise copy the link.
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('[data-share]');
        if (!b) return;
        var url = b.getAttribute('data-url') || location.origin + location.pathname;
        var text = b.getAttribute('data-text') || document.title;
        var live = b.parentNode.querySelector('[data-share-live]');
        function copied() {
          var l = b.querySelector('[data-share-label]'), old = b.getAttribute('data-label'), msg = b.getAttribute('data-copied');
          if (l) l.textContent = msg;
          if (live) live.textContent = msg;
          setTimeout(function () { if (l) l.textContent = old; if (live) live.textContent = ''; }, 2400);
        }
        if (navigator.share) {
          navigator.share({ title: document.title, text: text, url: url }).catch(function (err) {
            if (!err || err.name !== 'AbortError') copyIt();
          });
        } else copyIt();
        function copyIt() {
          function show() { if (live) live.textContent = url; }
          if (navigator.clipboard) navigator.clipboard.writeText(url).then(copied, show);
          else show();
        }
      });
    </script>
    <script>
      // Videos play only while visible. People who prefer less motion get a still poster and the play button.
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var vids = document.querySelectorAll('video[data-autoplay]');
        function sync(v) {
          var b = v.parentNode.querySelector('[data-toggle-video]');
          if (!b) return;
          var paused = v.paused;
          b.setAttribute('data-paused', paused ? 'true' : 'false');
          b.setAttribute('aria-label', paused ? b.getAttribute('data-play') : b.getAttribute('data-pause'));
        }
        vids.forEach(function (v) {
          v.userPaused = reduce;
          if (v.getAttribute('data-beats')) {
            var cuts = v.getAttribute('data-beats').split(',').map(Number);
            v.addEventListener('timeupdate', function () {
              var t = v.currentTime, i = 0;
              while (i < cuts.length && t >= cuts[i]) i += 1;
              v.parentNode.setAttribute('data-beat', String(i));
            });
          }
          v.addEventListener('play', function () { sync(v); });
          v.addEventListener('pause', function () { sync(v); });
          sync(v);
          if ('IntersectionObserver' in window) {
            new IntersectionObserver(function (e) {
              if (e[0].isIntersecting && !v.userPaused) v.play().catch(function () {});
              else v.pause();
            }, { threshold: 0.35 }).observe(v);
          }
          var b = v.parentNode.querySelector('[data-toggle-video]');
          if (b) b.addEventListener('click', function () { if (v.paused) { v.userPaused = false; v.play().catch(function () {}); } else { v.userPaused = true; v.pause(); } });
        });
      })();
    </script>
  </body>
</html>
